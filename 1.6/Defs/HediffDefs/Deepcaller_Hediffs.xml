<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>Deepcaller_FeedingCredit</defName>
    <label>flesh remembered by the deep</label>
    <description>The deep remembers the flesh its tentacles have already consumed from this creature.</description>
    <hediffClass>Deepcaller.Hediff_DeepFeedingCredit</hediffClass>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>
  <HediffDef>
    <defName>Deepcaller_Gripped</defName>
    <label>gripped by the deep</label>
    <description>A crushing tentacle grip. Movement is badly hampered until the victim wrenches free.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4,0.85,0.8)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>0.01</initialSeverity>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-30</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>held</label>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.45</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.55</minSeverity>
        <label>constricted</label>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.10</postFactor>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <postFactor>0.75</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Deepcaller_Grasped</defName>
    <label>grasped by the deep</label>
    <description>A tentacle has erupted from the ground and leashed this creature to that spot. It is slowed, and if it strays it is dragged back. The grip holds until the deep loses interest, or until enough damage tears the victim free.</description>
    <hediffClass>Deepcaller.Hediff_Grasped</hediffClass>
    <defaultLabelColor>(0.4,0.85,0.8)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <!-- Overwritten at cast time by the ability's durationTime -->
        <disappearsAfterTicks>900</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>held fast</label>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <!-- Slow, don't down: 0.05 downed the target, which tanks raid
                 morale and makes survivors flee on waking. The leash pull in
                 Hediff_Grasped provides the actual anchoring. -->
            <postFactor>0.4</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
    <modExtensions>
      <li Class="Deepcaller.GraspExtension">
        <severityPerDamage>0.03</severityPerDamage>
        <pullIntervalTicks>60</pullIntervalTicks>
        <leashRadius>1.9</leashRadius>
        <pullDistance>2</pullDistance>
        <!-- Idol devotion scaling (Ability_Grasp): duration 15/20/26/31s,
             damage to tear free ~33/50/66/83 at devotion 0-3 -->
        <durationFactorPerDevotion>0.35</durationFactorPerDevotion>
        <gripStrengthPerDevotion>0.5</gripStrengthPerDevotion>
      </li>
    </modExtensions>
  </HediffDef>

  <HediffDef>
    <defName>Deepcaller_Riptiden</defName>
    <label>dragged under</label>
    <description>Caught in the deep's current, being dragged toward its heart.</description>
    <hediffClass>Deepcaller.Hediff_Riptiden</hediffClass>
    <defaultLabelColor>(0.4,0.85,0.8)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <!-- Failsafe only: the drag removes itself on arrival/collision -->
        <disappearsAfterTicks>600</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <label>dragged</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Deepcaller_Inked</defName>
    <label>inked</label>
    <description>Abyssal ink in the eyes. Aim and reflexes suffer until it wears away.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4,0.85,0.8)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>0.25</initialSeverity>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <!-- Wears off on its own; higher devotion = blinder AND longer -->
        <severityPerDay>-8</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>smeared</label>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <postFactor>0.7</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.45</minSeverity>
        <label>blinded</label>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <postFactor>0.4</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>ink-black</label>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <postFactor>0.15</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Deepcaller_Symbiote</defName>
    <label>deep symbiote</label>
    <description>Living tentacles of the deep grafted onto this body. Each graft can lend tremendous dexterity once its host learns to command it — but a fresh graft fights every instruction, and the flesh must grow into the god.</description>
    <hediffClass>Deepcaller.Hediff_Symbiote</hediffClass>
    <defaultLabelColor>(0.4,0.85,0.8)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <modExtensions>
      <li Class="Deepcaller.SymbioteExtension">
        <!-- Manipulation points regained per day: -10 shock to +25 max in
             ~17.5 days -->
        <adaptPerDay>2</adaptPerDay>
      </li>
    </modExtensions>
  </HediffDef>

  <!-- Each glob dissolves another layer of protection. Severity rises by
       0.2 per unshielded hit: +8% incoming damage per stack, max +40%.
       Projectile_LeviathanGlob refreshes the 15-second duration. -->
  <HediffDef>
    <defName>Deepcaller_AbyssalSoftening</defName>
    <label>abyssally softened</label>
    <description>Leviathan sludge is digesting the boundary between this body and the deep. Each coating leaves the victim more vulnerable to every source of damage.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.25,0.85,0.82)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.2</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>slickened</label>
        <statOffsets>
          <IncomingDamageFactor>0.08</IncomingDamageFactor>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>softened</label>
        <statOffsets>
          <IncomingDamageFactor>0.16</IncomingDamageFactor>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>yielding</label>
        <statOffsets>
          <IncomingDamageFactor>0.24</IncomingDamageFactor>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>digested</label>
        <statOffsets>
          <IncomingDamageFactor>0.32</IncomingDamageFactor>
        </statOffsets>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>open to the deep</label>
        <statOffsets>
          <IncomingDamageFactor>0.40</IncomingDamageFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Tideguard: grants shield stats to the race's inert CompShield_Deep.
       Severity = growth stage + 1 (kept in sync by CompTentacleGrowth).
       Vanilla belt is 1.1 / 0.13 — Crushers reach belt parity. -->
  <HediffDef>
    <defName>Deepcaller_TideguardShield</defName>
    <label>tideguard</label>
    <description>A skin of pressurized deep-water psychic force. Shrugs off projectiles like the abyss shrugs off light; useless against a blade in reach.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4,0.85,0.8)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>4</maxSeverity>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <label>sprout</label>
        <statOffsets>
          <EnergyShieldEnergyMax>0.4</EnergyShieldEnergyMax>
          <EnergyShieldRechargeRate>0.06</EnergyShieldRechargeRate>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>grasper</label>
        <statOffsets>
          <EnergyShieldEnergyMax>0.7</EnergyShieldEnergyMax>
          <EnergyShieldRechargeRate>0.09</EnergyShieldRechargeRate>
        </statOffsets>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>crusher</label>
        <statOffsets>
          <EnergyShieldEnergyMax>1.1</EnergyShieldEnergyMax>
          <EnergyShieldRechargeRate>0.13</EnergyShieldRechargeRate>
        </statOffsets>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <label>colossus</label>
        <statOffsets>
          <EnergyShieldEnergyMax>1.6</EnergyShieldEnergyMax>
          <EnergyShieldRechargeRate>0.18</EnergyShieldRechargeRate>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>

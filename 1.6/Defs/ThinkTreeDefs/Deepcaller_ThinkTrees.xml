<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Organic-turret brain. Manhunter mental states are useless here: vanilla
       JobGiver_Manhunter filters targets to intelligence >= ToolUser, so a
       manhunter-brained guardian ignores hostile animals. JobGiver_AIFightEnemies
       (the mechanoid combat brain) attacks anything hostile to its faction. -->
  <ThinkTreeDef>
    <defName>Deepcaller_Tentacle</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="ThinkNode_QueuedJob" />
        <li Class="ThinkNode_Subtree">
          <treeDef>LordDuty</treeDef>
        </li>
        <!-- Radii here are fallbacks; JobGiver_TentacleFight widens them with
             growth stage (CompTentacleGrowth.AcquireRadius) -->
        <li Class="Deepcaller.JobGiver_TentacleFight">
          <targetAcquireRadius>32</targetAcquireRadius>
          <targetKeepRadius>40</targetKeepRadius>
        </li>
        <!-- Leviathan arms only (inert otherwise): settle back into their
             assigned aperture around the head after a short predatory reach. -->
        <li Class="Deepcaller.JobGiver_FollowLeviathanCore" />
        <!-- No enemies in reach: devour the fallen to grow -->
        <li Class="Deepcaller.JobGiver_ConsumeNearbyCorpse" />
        <!-- No threats: nose around like a curious summoned animal. Buds are
             the later, deliberately immobile branch; Sprouts should live. -->
        <li Class="ThinkNode_Tagger">
          <tagToGive>Idle</tagToGive>
          <subNodes>
            <li Class="JobGiver_WanderAnywhere">
              <maxDanger>Deadly</maxDanger>
            </li>
          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- Leviathan arms have no autonomous Sprout life. The head's shared
       command feeds JobGiver_TentacleFight; otherwise they settle into their
       hardpoint and remain there. -->
  <ThinkTreeDef>
    <defName>Deepcaller_LeviathanArm</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="ThinkNode_QueuedJob"/>
        <li Class="Deepcaller.JobGiver_TentacleFight">
          <targetAcquireRadius>8</targetAcquireRadius>
          <targetKeepRadius>8</targetKeepRadius>
        </li>
        <li Class="Deepcaller.JobGiver_FollowLeviathanCore"/>
        <li Class="Deepcaller.JobGiver_BudWait"/>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- Buds are living turrets. CompTurretGun acquires and shoots targets
       independently; their only job is to remain rooted on the cast square. -->
  <ThinkTreeDef>
    <defName>Deepcaller_Bud</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="Deepcaller.JobGiver_BudWait"/>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- Each flower has its own CompTurretGun targeter. Its pawn brain only
       keeps the bloom seated on its moving hardpoint, then waits without
       injecting a shared combat job. -->
  <ThinkTreeDef>
    <defName>Deepcaller_LeviathanFlower</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="Deepcaller.JobGiver_FollowLeviathanCore"/>
        <li Class="Deepcaller.JobGiver_BudWait"/>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- The Leviathan's head: advance toward nearby prey in short formation
       steps, otherwise pad after the summoner, otherwise drift. The sludge
       turret is a comp and fires independently of locomotion. -->
  <ThinkTreeDef>
    <defName>Deepcaller_LeviathanHead</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="ThinkNode_QueuedJob" />
        <li Class="ThinkNode_Subtree">
          <treeDef>LordDuty</treeDef>
        </li>
        <!-- Kept well under the sludge spitter's 26.9 range: the turret
             comp already punishes anything that comes into range, so the
             body only closes on nearby threats. Keep radius is measured
             from the (moving) pawn, so generous values turn into
             cross-map pursuits. -->
        <li Class="Deepcaller.JobGiver_TentacleFight">
          <targetAcquireRadius>14.9</targetAcquireRadius>
          <targetKeepRadius>18.9</targetKeepRadius>
        </li>
        <li Class="Deepcaller.JobGiver_FollowSummoner">
          <followRadius>4.9</followRadius>
        </li>
        <li Class="ThinkNode_Tagger">
          <tagToGive>Idle</tagToGive>
          <subNodes>
            <li Class="Deepcaller.JobGiver_LeviathanHeadIdle"/>
          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>
</Defs>
